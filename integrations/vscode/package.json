{
  "name": "universal-cicd-vscode",
  "displayName": "Universal CI/CD",
  "description": "Run and inspect the Universal CI/CD engine from Visual Studio Code.",
  "version": "0.9.0",
  "publisher": "Lvc4br",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onView:universalCicd.dashboard",
    "onCommand:universalCicd.openDashboard",
    "onCommand:universalCicd.version",
    "onCommand:universalCicd.initializeProject",
    "onCommand:universalCicd.showStatus",
    "onCommand:universalCicd.detect",
    "onCommand:universalCicd.plan",
    "onCommand:universalCicd.validateConfig",
    "onCommand:universalCicd.discoverProjects",
    "onCommand:universalCicd.history",
    "onCommand:universalCicd.exportReport",
    "onCommand:universalCicd.run",
    "onCommand:universalCicd.runWorkspaces",
    "onCommand:universalCicd.refreshDashboard",
    "onCommand:universalCicd.openOutput",
    "onCommand:universalCicd.inspectUps",
    "onCommand:universalCicd.configureEngine"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "universalCicd.dashboard",
          "name": "Universal CI/CD"
        }
      ]
    },
    "commands": [
      {
        "command": "universalCicd.inspectUps",
        "title": "Universal CI/CD: Inspecionar pipeline UPS (somente leitura)"
      },
      {
        "command": "universalCicd.openDashboard",
        "title": "Universal CI/CD: Abrir dashboard"
      },
      {
        "command": "universalCicd.version",
        "title": "Universal CI/CD: Versão do motor"
      },
      {
        "command": "universalCicd.initializeProject",
        "title": "Universal CI/CD: Inicializar projeto"
      },
      {
        "command": "universalCicd.showStatus",
        "title": "Universal CI/CD: Status do projeto"
      },
      {
        "command": "universalCicd.detect",
        "title": "Universal CI/CD: Detectar tecnologias"
      },
      {
        "command": "universalCicd.plan",
        "title": "Universal CI/CD: Gerar plano"
      },
      {
        "command": "universalCicd.validateConfig",
        "title": "Universal CI/CD: Validar configuração"
      },
      {
        "command": "universalCicd.discoverProjects",
        "title": "Universal CI/CD: Descobrir projetos do workspace"
      },
      {
        "command": "universalCicd.history",
        "title": "Universal CI/CD: Histórico"
      },
      {
        "command": "universalCicd.exportReport",
        "title": "Universal CI/CD: Exportar relatório"
      },
      {
        "command": "universalCicd.run",
        "title": "Universal CI/CD: Executar pipeline (com aprovação)"
      },
      {
        "command": "universalCicd.runWorkspaces",
        "title": "Universal CI/CD: Executar projetos do workspace (com aprovação)"
      },
      {
        "command": "universalCicd.refreshDashboard",
        "title": "Universal CI/CD: Atualizar painel"
      },
      {
        "command": "universalCicd.openOutput",
        "title": "Universal CI/CD: Abrir saída"
      },
      {
        "command": "universalCicd.configureEngine",
        "title": "Universal CI/CD: Configurar localização do motor"
      }
    ],
    "configuration": {
      "title": "Universal CI/CD",
      "properties": {
        "universalCicd.enginePath": {
          "type": "string",
          "default": "",
          "description": "Caminho absoluto da pasta que contém cicd.ps1. Se vazio, a extensão procura no workspace."
        },
        "universalCicd.powershellExecutable": {
          "type": "string",
          "default": "pwsh",
          "description": "Nome do executável PowerShell 7 ou caminho absoluto."
        },
        "universalCicd.timeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 1,
          "maximum": 86400,
          "description": "Tempo limite para comandos do motor, em segundos."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lvc4br/Especifica-o-Universal-CI-CD-.git"
  },
  "dependencies": {
    "@universal-cicd/contracts": "0.1.0"
  }
}
