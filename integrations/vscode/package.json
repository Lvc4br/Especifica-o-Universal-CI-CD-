{
  "name": "@universal-cicd/vscode",
  "displayName": "Universal CI/CD",
  "description": "Run and inspect the Universal CI/CD engine from Visual Studio Code.",
  "version": "0.2.0",
  "publisher": "Lvc4br",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other", "Programming Languages"],
  "activationEvents": [
    "onCommand:universalCicd.version",
    "onCommand:universalCicd.initializeProject",
    "onCommand:universalCicd.showStatus",
    "onCommand:universalCicd.detect",
    "onCommand:universalCicd.plan",
    "onCommand:universalCicd.validateConfig",
    "onCommand:universalCicd.discoverProjects",
    "onCommand:universalCicd.history",
    "onCommand:universalCicd.exportReport",
    "onCommand:universalCicd.run",
    "onCommand:universalCicd.runWorkspaces"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "universalCicd.version", "title": "Universal CI/CD: Versão do motor" },
      { "command": "universalCicd.initializeProject", "title": "Universal CI/CD: Inicializar projeto" },
      { "command": "universalCicd.showStatus", "title": "Universal CI/CD: Status do projeto" },
      { "command": "universalCicd.detect", "title": "Universal CI/CD: Detectar tecnologias" },
      { "command": "universalCicd.plan", "title": "Universal CI/CD: Gerar plano" },
      { "command": "universalCicd.validateConfig", "title": "Universal CI/CD: Validar configuração" },
      { "command": "universalCicd.discoverProjects", "title": "Universal CI/CD: Descobrir projetos do workspace" },
      { "command": "universalCicd.history", "title": "Universal CI/CD: Histórico" },
      { "command": "universalCicd.exportReport", "title": "Universal CI/CD: Exportar relatório" },
      { "command": "universalCicd.run", "title": "Universal CI/CD: Executar pipeline (com aprovação)" },
      { "command": "universalCicd.runWorkspaces", "title": "Universal CI/CD: Executar projetos do workspace (com aprovação)" }
    ],
    "configuration": {
      "title": "Universal CI/CD",
      "properties": {
        "universalCicd.enginePath": {
          "type": "string",
          "default": "",
          "description": "Caminho absoluto da pasta que contém cicd.ps1. Se vazio, a extensão procura no workspace."
        },
        "universalCicd.powershellExecutable": {
          "type": "string",
          "default": "pwsh",
          "description": "Nome do executável PowerShell 7 ou caminho absoluto."
        },
        "universalCicd.timeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 1,
          "maximum": 86400,
          "description": "Tempo limite para comandos do motor, em segundos."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
