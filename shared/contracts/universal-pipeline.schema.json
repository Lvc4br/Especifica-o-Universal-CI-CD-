{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-cicd.dev/schemas/pipeline-v1.json",
  "title": "Universal Pipeline Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "jobs"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "description": {
      "type": "string"
    },
    "trigger": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/job"
      },
      "maxProperties": 500,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "continueOnError": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "args"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "continueOnError": {
          "type": "boolean"
        }
      }
    }
  }
}
