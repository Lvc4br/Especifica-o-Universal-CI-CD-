{
  "version": "1",
  "name": "python-quality",
  "description": "Illustrative Python quality pipeline",
  "jobs": {
    "quality": {
      "name": "Quality checks",
      "runsOn": [
        "local",
        "python"
      ],
      "timeoutSeconds": 1200,
      "steps": [
        {
          "id": "lint",
          "name": "Ruff lint",
          "run": {
            "executable": "ruff",
            "args": [
              "check",
              "."
            ]
          },
          "timeoutSeconds": 300
        },
        {
          "id": "tests",
          "name": "Pytest",
          "run": {
            "executable": "python",
            "args": [
              "-m",
              "pytest",
              "-q"
            ]
          },
          "timeoutSeconds": 900
        }
      ]
    }
  }
}